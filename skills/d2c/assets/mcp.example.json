{
  "mcpServers": {
    "figma-official": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "figma-context": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--figma-api-key=<YOUR_FIGMA_API_KEY>",
        "--stdio"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
